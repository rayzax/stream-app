# Local dev only — copy to .env (gitignored). In GCP this all comes from
# Secret Manager via Terraform instead; this file is never used there.

XTREAM_SERVER=http://your-provider:port
XTREAM_USERNAME=
XTREAM_PASSWORD=

# bcrypt hash of your app login password (NOT the plaintext password).
# Generate one locally: see scripts/setup-app-password.sh, or:
#   node -e "require('bcrypt').hash(process.argv[1], 12).then(console.log)" "your-password"
APP_PASSWORD_HASH=

# Any random strings for local dev — use `openssl rand -base64 32` for real ones.
SESSION_SIGNING_KEY=
STREAM_TOKEN_HMAC_KEY=

# Leave blank for local dev — disables GCS catalog persistence, uses live fetch only.
CACHE_BUCKET=
GCP_PROJECT_ID=
