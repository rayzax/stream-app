# Copy to .env (gitignored) and fill in.

# Same Xtream credentials as in GCP Secret Manager (xtream-server/username/password).
XTREAM_SERVER=http://your-provider:port
XTREAM_USERNAME=
XTREAM_PASSWORD=

# MUST exactly match the `stream-token-hmac-key` secret value in GCP Secret
# Manager — Cloud Run issues the stream tokens, this proxy verifies them, so
# the signing key has to be identical on both sides. Get it with:
#   gcloud secrets versions access latest --secret=stream-token-hmac-key --project=stream-iptv-prd
STREAM_TOKEN_HMAC_KEY=

# From Cloudflare Zero Trust dashboard > Networks > Tunnels > (your tunnel) > Install connector.
TUNNEL_TOKEN=
